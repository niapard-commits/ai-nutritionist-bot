# Copy this file to ".env" and fill it in. NEVER commit ".env".

# Main bot (nutritionist_bot.py): token from @BotFather
NUTRITION_BOT_TOKEN=
# Recipe parser bot (bot.py): a second bot token from @BotFather
VIDEO_BOT_TOKEN=
# Your Telegram user ID (from @userinfobot); several IDs separated by commas
OWNER_ID=

# Google Gemini API keys (https://aistudio.google.com/apikey)
# Free-tier keys are rotated automatically: GEMINI_KEY_FREE_1, _2, _3 ...
GEMINI_KEY_FREE_1=
# Optional paid key, used only when all free keys are exhausted
GEMINI_KEY_PAID=

# Optional limits (0 = no limit)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_RPM_LIMIT=14
# GEMINI_PAID_MAX_PER_DAY=0
# USER_RPM_LIMIT=0
# USER_DAILY_LIMIT=0
